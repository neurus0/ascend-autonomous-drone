# Serial port for MAVLink (flight controller)
# Linux: /dev/ttyUSB0 or /dev/ttyAMA0
# Mac:   /dev/cu.usbserial-XXXX
# Win:   COM3
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=57600

# UDP port for receiving telemetry from companion Pi
UDP_HOST=0.0.0.0
UDP_PORT=14550

# HTTP server port
SERVER_PORT=3000

# Camera stream URL (MJPEG from drone Pi)
CAMERA_URL=http://192.168.1.50:8081

# Drone Pi IP (for sending commands)
DRONE_IP=192.168.1.50
DRONE_UDP_PORT=14555

# Set to true to use simulated data (no drone required)
SIMULATE=false
